# Copy this file to .env and fill in your own values.
# Never commit .env.

# LLM providers. You can use one or both depending on your config.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# SEC asks automated clients to identify themselves.
# Example: your-name@example.com
SEC_USER_AGENT_EMAIL=

# Telegram is optional but useful for alerts and command UX.
TELEGRAM_ASCR_BOT_TOKEN=
TELEGRAM_ASCR_H_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local paths. Defaults should work if you run from this repo root.
ASCR_ROOT=
ASCR_DB_PATH=
ASCR_H_DB_PATH=
